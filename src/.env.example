# Sovereign Arms — site configuration
# Copy this file to .env and fill in your details. All values are public
# display info (NEXT_PUBLIC_ prefix makes them available to both server and
# client components). Changing them updates the site globally.

NEXT_PUBLIC_SITE_NAME=Your Store Name
NEXT_PUBLIC_SITE_MARK=♠
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_SITE_DESCRIPTION=Shop new & used firearms, parts, ammunition and optics online.

NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_DEALERS_EMAIL=dealers@yourdomain.com
NEXT_PUBLIC_INFO_EMAIL=info@yourdomain.com

NEXT_PUBLIC_PHONE=1-800-555-0000
NEXT_PUBLIC_PHONE_HREF=tel:+18005550000
NEXT_PUBLIC_SUPPORT_HOURS=Monday–Friday, 8am–6pm CT

# WhatsApp number used for cashout — digits only, include country code (e.g. 14155550000)
NEXT_PUBLIC_WHATSAPP_NUMBER=18005550000
NEXT_PUBLIC_WHATSAPP_LABEL=Order on WhatsApp

NEXT_PUBLIC_ADDRESS_LINE1=123 Main Street
NEXT_PUBLIC_ADDRESS_LINE2=Suite 100
NEXT_PUBLIC_ADDRESS_CITY=Dallas
NEXT_PUBLIC_ADDRESS_STATE=TX
NEXT_PUBLIC_ADDRESS_ZIP=75201
NEXT_PUBLIC_ADDRESS_COUNTRY=United States

NEXT_PUBLIC_COPYRIGHT_OWNER=Your Store Name
NEXT_PUBLIC_COPYRIGHT_YEAR=2026

# "Last updated" date shown on legal/policy pages
NEXT_PUBLIC_LAST_UPDATED=January 2026

NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/yourstore
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@yourstore
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/yourstore
NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@yourstore
NEXT_PUBLIC_SOCIAL_X=https://x.com/yourstore
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/yourstore
