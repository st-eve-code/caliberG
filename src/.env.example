# CaliberGuns - site configuration
# Copy this file to .env and fill in your details. All values are public
# display info (NEXT_PUBLIC_ prefix makes them available to both server and
# client components). Changing them updates the site globally.

NEXT_PUBLIC_PHONE=770-432-1202
NEXT_PUBLIC_PHONE_HREF=tel:+17704321202
NEXT_PUBLIC_SUPPORT_HOURS=Monday-Friday, 8am-5pm ET

# WhatsApp number used for orders - digits only, include country code (e.g. 14155550000)
NEXT_PUBLIC_WHATSAPP_NUMBER=17704321202
NEXT_PUBLIC_WHATSAPP_LABEL=Order on WhatsApp

NEXT_PUBLIC_ADDRESS_LINE1=6000 Highlands Parkway SE
NEXT_PUBLIC_ADDRESS_LINE2=
NEXT_PUBLIC_ADDRESS_CITY=Smyrna
NEXT_PUBLIC_ADDRESS_STATE=GA
NEXT_PUBLIC_ADDRESS_ZIP=30082
NEXT_PUBLIC_ADDRESS_COUNTRY=United States

# Payment methods shown at checkout. Leave a value blank to hide that address.
# Bitcoin wallet address (mainnet or testnet, set the network below)
NEXT_PUBLIC_PAYMENT_BITCOIN_ADDRESS=
NEXT_PUBLIC_PAYMENT_BITCOIN_NETWORK=Bitcoin (mainnet)
# Apple Pay: email used to confirm the Apple Pay order
NEXT_PUBLIC_PAYMENT_APPLEPAY_EMAIL=
# Zelle: email and/or mobile number registered to your Zelle account
NEXT_PUBLIC_PAYMENT_ZELLE_EMAIL=
NEXT_PUBLIC_PAYMENT_ZELLE_PHONE=
# Cash App: $cashtag (with or without the leading $)
NEXT_PUBLIC_PAYMENT_CASHAPP_TAG=
# Chime: handle and/or email registered to your Chime account
NEXT_PUBLIC_PAYMENT_CHIME_EMAIL=
NEXT_PUBLIC_PAYMENT_CHIME_HANDLE=

NEXT_PUBLIC_SITE_NAME=CaliberGuns
NEXT_PUBLIC_SITE_MARK=CG
NEXT_PUBLIC_SITE_URL=https://caliberguns.com
NEXT_PUBLIC_SITE_DESCRIPTION=Shop firearms, parts, ammunition and optics online.
NEXT_PUBLIC_SUPPORT_EMAIL=support@caliberguns.com
NEXT_PUBLIC_DEALERS_EMAIL=dealers@caliberguns.com
NEXT_PUBLIC_INFO_EMAIL=info@caliberguns.com
NEXT_PUBLIC_COPYRIGHT_OWNER=CaliberGuns
NEXT_PUBLIC_COPYRIGHT_YEAR=2026

# Social links (leave blank to hide)
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# "Last updated" date shown on legal/policy pages
NEXT_PUBLIC_LAST_UPDATED=October 2026
